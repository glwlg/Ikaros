# Copy to .env or run ./bootstrap-env.sh.
N8N_IMAGE=docker.n8n.io/n8nio/n8n
N8N_BIND_HOST=0.0.0.0
N8N_HOST=192.168.1.100
N8N_HOST_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://192.168.1.100:5678/
N8N_EDITOR_BASE_URL=http://192.168.1.100:5678/
N8N_SECURE_COOKIE=false

GENERIC_TIMEZONE=Asia/Shanghai

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-a-random-password
N8N_ENCRYPTION_KEY=replace-with-a-random-key
